/*
 * Description: This module provides the SLH-DSA hypertree [FIPS-205 Section 7],
 * the composition of XMSS across d layers.
 */

module algorithms::SLH_DSA::HyperTree where

import algorithms::SLH_DSA::Address
import algorithms::SLH_DSA::XMSS as X where
  type n = _n
  type m = _m
  type hp = _hp

parameter

  type n : #
  type constraint (fin n, n >= 16, n <= 32)

  type m : #
  type constraint (fin m, m >= 1)

  type hp : #
  type constraint (fin hp, hp >= 1, hp <= 20)

  type d : #
  type constraint (fin d, d >= 1, d <= 22)

type _n = n
type _m = m
type _hp = hp

type NBytes = [n][8]
type IdxW = 32
type TreeW = 96
type HtSig = [d]X::XmssSig

ixs : {len} (fin len) => [len][IdxW]
ixs = take [0 ...]

idxTreeChain : [TreeW] -> [d][TreeW]
idxTreeChain idxTree = take ([idxTree] # [ it >> (`hp : [TreeW]) | it <- idxTreeChain idxTree ])

htAddrs : [TreeW] -> [d]ADRS
htAddrs idxTree =
  [ setTreeAddress (setLayerAddress zero j) (chain @ j) | j <- ixs`{d} ]
  where chain = idxTreeChain idxTree

htLeaves : [TreeW] -> [IdxW] -> [d][IdxW]
htLeaves idxTree idxLeaf =
  [idxLeaf] # [ drop`{TreeW - IdxW} ((chain @ j) && mask) | j <- ixs`{d - 1} ]
  where
    chain = idxTreeChain idxTree
    mask = (2 ^^ (`hp : [TreeW])) - 1

htSign : NBytes -> NBytes -> NBytes -> [TreeW] -> [IdxW] -> HtSig
htSign msg skSeed pkSeed idxTree idxLeaf = sigs
  where
    addrs = htAddrs idxTree
    leaves = htLeaves idxTree idxLeaf
    roots = [msg] # [ X::xmssRoot skSeed pkSeed (addrs @ j) | j <- ixs`{d - 1} ]
    sigs = [ X::xmssSign (roots @ j) skSeed pkSeed (addrs @ j) (leaves @ j) | j <- ixs`{d} ]

htRoot : NBytes -> NBytes -> [TreeW] -> NBytes
htRoot skSeed pkSeed idxTree = X::xmssRoot skSeed pkSeed ((htAddrs idxTree) @ (`d - 1 : [IdxW]))

htVerify : NBytes -> NBytes -> HtSig -> [TreeW] -> [IdxW] -> NBytes -> Bit
htVerify msg pkSeed sigs idxTree idxLeaf rootPk = (nodes @ (`d - 1 : [IdxW])) == rootPk
  where
    addrs = htAddrs idxTree
    leaves = htLeaves idxTree idxLeaf
    nodes = [ X::xmssPkFromSig (leaves @ 0) (sigs @ 0) msg pkSeed (addrs @ 0) ] #
            [ X::xmssPkFromSig (leaves @ (j + 1)) (sigs @ (j + 1)) (nodes @ j) pkSeed (addrs @ (j + 1))
            | j <- ixs`{d - 1} ]
